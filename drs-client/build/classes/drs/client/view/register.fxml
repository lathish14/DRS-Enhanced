<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    Register Screen - DRS-Enhanced (client tier)
    Same split layout as login: form left, image right.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="drs.client.controller.RegisterController"
            prefWidth="1280" prefHeight="800">

    <!-- Navigation bar -->
    <top>
        <HBox styleClass="navbar" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <StackPane styleClass="nav-logo-box">
                    <Label styleClass="nav-logo-symbol" text="&#9888;"/>
                </StackPane>
                <Label styleClass="nav-brand-text"
                       text="Disaster&#10;Response&#10;System"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="32">
                <Button styleClass="nav-link" text="LOG IN"
                        onAction="#handleBack"/>
                <Button styleClass="nav-link-active" text="REGISTER"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox>

            <!-- LEFT: registration form -->
            <StackPane HBox.hgrow="ALWAYS" styleClass="split-pane-left">
                <VBox alignment="CENTER" spacing="0" maxWidth="420">

                    <Label styleClass="form-title" text="Create Account"
                           style="-fx-font-size:28px;">
                        <VBox.margin><Insets bottom="22"/></VBox.margin>
                    </Label>

                    <!-- Error box -->
                    <VBox fx:id="errorBox" styleClass="error-box"
                          managed="false" visible="false" prefWidth="380">
                        <Label fx:id="errorLabel" styleClass="error-label"
                               wrapText="true" text=""/>
                        <VBox.margin><Insets bottom="10"/></VBox.margin>
                    </VBox>

                    <!-- Success box -->
                    <VBox fx:id="successBox" styleClass="success-box"
                          managed="false" visible="false" prefWidth="380">
                        <Label fx:id="successLabel" styleClass="success-label"
                               wrapText="true" text=""/>
                        <VBox.margin><Insets bottom="10"/></VBox.margin>
                    </VBox>

                    <!-- Full name -->
                    <TextField fx:id="fullNameField" styleClass="drs-input"
                               promptText="Full name" prefWidth="380">
                        <VBox.margin><Insets bottom="12"/></VBox.margin>
                    </TextField>

                    <!-- Username -->
                    <TextField fx:id="usernameField" styleClass="drs-input"
                               promptText="Username (min 3 characters)"
                               prefWidth="380">
                        <VBox.margin><Insets bottom="12"/></VBox.margin>
                    </TextField>

                    <!-- Password -->
                    <PasswordField fx:id="passwordField" styleClass="drs-input"
                                   promptText="Password (min 6 characters)"
                                   prefWidth="380">
                        <VBox.margin><Insets bottom="12"/></VBox.margin>
                    </PasswordField>

                    <!-- Confirm password -->
                    <PasswordField fx:id="confirmPasswordField"
                                   styleClass="drs-input"
                                   promptText="Confirm password"
                                   prefWidth="380">
                        <VBox.margin><Insets bottom="12"/></VBox.margin>
                    </PasswordField>

                    <!-- Role -->
                    <ComboBox fx:id="roleCombo" styleClass="drs-combo"
                              promptText="Select role" prefWidth="380">
                        <VBox.margin><Insets bottom="12"/></VBox.margin>
                    </ComboBox>

                    <!-- Department (optional) -->
                    <TextField fx:id="departmentField" styleClass="drs-input"
                               promptText="Department / organisation (optional)"
                               prefWidth="380">
                        <VBox.margin><Insets bottom="20"/></VBox.margin>
                    </TextField>

                    <!-- Register button -->
                    <Button styleClass="btn-primary" text="Create Account"
                            prefWidth="380" onAction="#handleRegister">
                        <VBox.margin><Insets bottom="14"/></VBox.margin>
                    </Button>

                    <!-- Back to login -->
                    <HBox alignment="CENTER_LEFT" prefWidth="380">
                        <Label style="-fx-font-size:12px;
                                      -fx-text-fill:#6B6B8A;"
                               text="Already have an account?  "/>
                        <Label styleClass="link-label" text="Log in"
                               onMouseClicked="#handleBackClick"/>
                    </HBox>

                </VBox>
            </StackPane>

            <!-- RIGHT: photo -->
            <StackPane prefWidth="640" minWidth="400"
                       style="-fx-background-color:#1A1A2E;">
                <ImageView fitWidth="640" fitHeight="800"
                           preserveRatio="false" smooth="true">
                    <image>
                        <Image url="@images/login_photo.jpg"
                               backgroundLoading="true"/>
                    </image>
                </ImageView>
            </StackPane>

        </HBox>
    </center>

</BorderPane>
